# Copy to .env for local development. On Railway set these as service variables.

# --- Build time (inlined into the client bundle) ---
# These must be present when `bun run build` runs, not just at runtime.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Runtime (server only) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Used by the admin client in src/lib/orders.functions.ts. Never expose this to
# the browser or prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Optional: only needed if you call the cron-authenticated endpoints.
# LOVABLE_CRON_SECRET=""
# LOVABLE_CRON_SECRET_PREVIOUS=""
