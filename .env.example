# Copy to .env for local development. On Railway this is provided automatically
# by referencing the Postgres service, so you normally set nothing by hand.

# Connection string for the Postgres database. On Railway set this as a
# reference variable so it tracks the database: ${{ Postgres.DATABASE_URL }}
#
# Locally, point it at any Postgres instance, e.g. one started with:
#   docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Set to "production" so session cookies are marked Secure. Railway's Docker
# image sets this already; leave it unset locally so cookies work over http.
# NODE_ENV="production"
